{
	"$schema": "./schemas/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "PremiumCMS site seed",
		"description": "Content-as-code for premium-cms.com. Applied on every deploy (update-on-conflict); edit here, not in the admin, for anything this seed names."
	},
	"collections": [
		{
			"slug": "products",
			"label": "Products",
			"labelSingular": "Product",
			"hasSeo": true,
			"supports": [
				"drafts",
				"revisions",
				"search"
			],
			"urlPattern": "/products/{slug}",
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "price",
					"label": "Price",
					"type": "number",
					"required": true
				},
				{
					"slug": "compare_at_price",
					"label": "Compare-at price",
					"type": "number"
				},
				{
					"slug": "sku",
					"label": "SKU",
					"type": "string"
				},
				{
					"slug": "stock",
					"label": "Stock (blank = unlimited)",
					"type": "integer"
				},
				{
					"slug": "image",
					"label": "Image",
					"type": "image"
				},
				{
					"slug": "summary",
					"label": "Summary",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "description",
					"label": "Description",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "requires_shipping",
					"label": "Requires shipping",
					"type": "boolean",
					"defaultValue": true
				},
				{
					"slug": "featured",
					"label": "Featured",
					"type": "boolean"
				}
			]
		}
	],
	"settings": {
		"title": "PremiumCMS",
		"tagline": "Isolated CMS instances on your clients' own domains"
	},
	"menus": [
		{
			"name": "primary",
			"label": "Primary",
			"items": [
				{
					"type": "custom",
					"label": "Home",
					"url": "/"
				},
				{
					"type": "custom",
					"label": "Changelog",
					"url": "/posts"
				},
				{
					"type": "custom",
					"label": "About",
					"url": "/pages/about"
				}
			]
		}
	],
	"redirects": [
		{
			"source": "/admin",
			"destination": "/_emdash/admin",
			"type": 302
		},
		{
			"source": "/login",
			"destination": "/_emdash/admin",
			"type": 302
		},
		{
			"source": "/blog",
			"destination": "/posts",
			"type": 301
		},
		{
			"source": "/docs",
			"destination": "/pages/connecting-your-domain",
			"type": 302
		}
	],
	"widgetAreas": [
		{
			"name": "footer",
			"label": "Footer widgets",
			"description": "Rendered in the footer's widget column.",
			"widgets": [
				{
					"type": "content",
					"title": "Platform",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "w0",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "w1",
									"text": "Every site here runs the same golden build. What changed and when lives in the changelog."
								}
							]
						}
					]
				}
			]
		}
	],
	"content": {}
}
